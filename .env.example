# Real-Debrid API Configuration
# Get your API key from: https://real-debrid.com/apitoken
API_KEY=your-real-debrid-api-key-here

# Polling interval in milliseconds (default: 5 minutes = 300000ms)
POLL_INTERVAL_MS=300000

# WebDAV server port
WEBDAV_PORT=1900

# Directory for .strm files (relative to project root)
STRM_DIR=./strm-files
